# Stable configuration with minimal enhancements
<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Allow Let's Encrypt ACME challenges to be served as static files
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Preserve HTTP Authorization header (needed for token authentication)
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

    # --- BIOMETRIC CALLBACK: Allow HTTP without redirect ---
    # Skip ALL redirects when accessing via IP address or callback URL
    RewriteCond %{HTTP_HOST} ^69\.62\.81\.218 [NC,OR]
    RewriteCond %{HTTP_HOST} ^69\.62\.81\.218:80 [NC,OR]
    RewriteCond %{REQUEST_URI} ^/cams-callback\.php$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/core/cams-biometric-callback\.php$ [NC]
    RewriteRule ^ - [L]

    # Force www and HTTPS (except IP access and biometric callback)
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} !^69\.62\.81\.218 [NC]
    RewriteCond %{REQUEST_URI} !^/cams-callback\.php$ [NC]
    RewriteCond %{REQUEST_URI} !^/core/cams-biometric-callback\.php$ [NC]
    RewriteRule ^(.*)$ https://www.bombayengg.net/$1 [L,R=301]

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^69\.62\.81\.218 [NC]
    RewriteCond %{REQUEST_URI} !^/cams-callback\.php$ [NC]
    RewriteCond %{REQUEST_URI} !^/core/cams-biometric-callback\.php$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect /xadmin to login
    RewriteCond %{HTTP_HOST} ^bombayengg\.net$ [NC]
    RewriteCond %{REQUEST_URI} ^/xadmin/?$ [NC]
    RewriteRule ^xadmin/?$ https://www.bombayengg.net/xadmin/login/ [L,R=301]

    # Redirect old KC URL to correct URL with -1 suffix
    RewriteRule ^knowledge-center/common-motor-failures-and-how-to-prevent-them/?$ https://www.bombayengg.net/knowledge-center/common-motor-failures-and-how-to-prevent-them-1/ [L,R=301]

    # ── OLD URL REDIRECTS (301) ──────────────────────────────────────────
    # index.php → homepage
    RewriteRule ^index\.php$ https://www.bombayengg.net/ [L,R=301]

    # /motors/ (plural) → /motor/ (singular) — old URL structure
    RewriteRule ^motors/(.*)$ https://www.bombayengg.net/motor/$1 [L,R=301]
    # /pumps/ (plural) → /pump/ (singular) — old URL structure
    RewriteRule ^pumps/(.*)$ https://www.bombayengg.net/pump/$1 [L,R=301]

    # OLD MOTOR CATEGORY URLs → correct current paths
    RewriteRule ^motor/low-voltage-ac-motor/squirrel-cage-motor-ie2-efficiency/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-ac-motor/squirrel-cage-motor-ie3-efficiency/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-ac-motor/squirrel-cage-motor-ie4-efficiency/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-ac-motor/squirrel-cage-motor-ie2-efficiency/safe-area-squirrel-cage-ie2-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/ [L,R=301]
    RewriteRule ^motor/high-voltage-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/ [L,R=301]
    RewriteRule ^motor/energy-efficient-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/ [L,R=301]
    RewriteRule ^motor/hazardous-area-motors-lv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/motors-for-hazardous-area-lv/ [L,R=301]
    RewriteRule ^motor/hazardous-area-motors-hv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/motors-for-hazardous-areas-hv/ [L,R=301]
    RewriteRule ^motor/dc-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/ [L,R=301]
    RewriteRule ^motor/dc-motor/solid-yoke-dc-motor/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/ [L,R=301]
    RewriteRule ^motor/dc-motors/laminated-yoke-dc-motor/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/ [L,R=301]
    RewriteRule ^motor/special-application-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/special-application-motors/ [L,R=301]

    # OLD MOTOR PRODUCT URLs → correct category/product paths
    # Products under old "low-voltage-motors" category
    RewriteRule ^motor/low-voltage-motors/cast-iron-enclosure-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/cast-iron-enclosure-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/aluminum-enclosure-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/aluminum-enclosure-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/flame-proof-motors-ex-db-lv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/flame-proof-motors-ex-db-lv/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/smartor-cg-smart-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/smartor-cg-smart-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/increased-safety-motors-ex-eb-lv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/increased-safety-motors-ex-eb-lv/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/axelera-process-performance-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/axelera-process-performance-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/slip-ring-motors-lv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/slip-ring-motors-lv/ [L,R=301]
    RewriteRule ^motor/low-voltage-motors/non-sparking-motor-ex-na-ec-lv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/non-sparking-motor-ex-na-ec-lv/ [L,R=301]

    # Products under old "high-voltage-motors" category
    RewriteRule ^motor/high-voltage-motors/air-cooled-induction-motors-ic-6a1a1/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/air-cooled-induction-motors-ic-6a1a1/ [L,R=301]
    RewriteRule ^motor/high-voltage-motors/double-cage-motor-cement-mill/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/double-cage-motor-cement-mill/ [L,R=301]
    RewriteRule ^motor/high-voltage-motors/water-cooled-induction-motors-ic-8a1w7/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/water-cooled-induction-motors-ic-8a1w7/ [L,R=301]
    RewriteRule ^motor/high-voltage-motors/fan-cooled-induction-motor-tefc/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/fan-cooled-induction-motor-tefc/ [L,R=301]
    RewriteRule ^motor/high-voltage-motors/energy-efficient-motors-hv-n-series/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/energy-efficient-motors-hv-n-series/ [L,R=301]
    RewriteRule ^motor/high-voltage-motors/tube-ventilated-induction-motor/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/tube-ventilated-induction-motor/ [L,R=301]
    RewriteRule ^motor/high-voltage-motors/open-air-type-induction-motor/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/open-air-type-induction-motor/ [L,R=301]

    # Products under old "energy-efficient-motors" category
    RewriteRule ^motor/energy-efficient-motors/international-efficiency-ie2-ie3-apex/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/international-efficiency-ie2-ie3-apex/ [L,R=301]
    RewriteRule ^motor/energy-efficient-motors/super-premium-ie4-efficiency-apex/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/super-premium-ie4-efficiency-apex/ [L,R=301]
    RewriteRule ^motor/energy-efficient-motors/totally-enclosed-fan-cooled-ng-series/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/energy-efficient-motors/totally-enclosed-fan-cooled-ng-series/ [L,R=301]

    # Products under old "hazardous-area-motors" categories
    RewriteRule ^motor/hazardous-area-motors-lv/flame-proof-motors-hazardous-lv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/motors-for-hazardous-area-lv/ [L,R=301]
    RewriteRule ^motor/hazardous-area-motors-lv/non-sparking-safety-motors-lv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/motors-for-hazardous-area-lv/ [L,R=301]
    RewriteRule ^motor/hazardous-area-motors-hv/flame-proof-motors-hv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/motors-for-hazardous-areas-hv/flame-proof-motors-hv/ [L,R=301]
    RewriteRule ^motor/hazardous-area-motors-hv/explosion-proof-motors-hv/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/motors-for-hazardous-areas-hv/explosion-proof-motors-hv/ [L,R=301]

    # Products under old "dc-motors" category
    RewriteRule ^motor/dc-motors/large-dc-machines/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/large-dc-machines/ [L,R=301]
    RewriteRule ^motor/dc-motors/dc-motors-general/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/dc-motors-general/ [L,R=301]
    RewriteRule ^motor/dc-motors/bajaj-motor/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/ [L,R=301]

    # Products under old "special-application-motors" category
    RewriteRule ^motor/special-application-motors/brake-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/special-application-motors/brake-motors/ [L,R=301]
    RewriteRule ^motor/special-application-motors/oil-well-pump-motor/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/special-application-motors/oil-well-pump-motor/ [L,R=301]
    RewriteRule ^motor/special-application-motors/double-cage-motor-cement-mill-app/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/special-application-motors/double-cage-motor-cement-mill-app/ [L,R=301]
    RewriteRule ^motor/special-application-motors/re-rolling-mill-motor/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/special-application-motors/re-rolling-mill-motor/ [L,R=301]

    # Products under old "fhp-commercial-motors/3-phase-motors-rolled-steel-body" (cat 103 inactive, redirect to parent)
    RewriteRule ^motor/fhp-commercial-motors/3-phase-motors-rolled-steel-body/?$ https://www.bombayengg.net/motor/fhp-commercial-motors/ [L,R=301]
    RewriteRule ^motor/fhp-commercial-motors/3-phase-motors-rolled-steel-body/(.+)$ https://www.bombayengg.net/motor/fhp-commercial-motors/ [L,R=301]

    # OLD PUMP CATEGORY/PRODUCT URLs → correct current paths
    RewriteRule ^pump/residential-pumps/residential-submersible-pumps/?$ https://www.bombayengg.net/pump/residential-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/residential-submersible-pumps/(.+)$ https://www.bombayengg.net/pump/residential-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/inline-circulation-pump/?$ https://www.bombayengg.net/pump/residential-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/tata-pump/?$ https://www.bombayengg.net/pump/residential-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/self-priming-regenerative-mini/?$ https://www.bombayengg.net/pump/residential-pumps/shallow-well-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/compressor-pump/?$ https://www.bombayengg.net/pump/residential-pumps/booster-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/openwell-submersible/?$ https://www.bombayengg.net/pump/residential-pumps/openwell-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/centrifugal-deep-well-jet/?$ https://www.bombayengg.net/pump/residential-pumps/4-inch-borewell/ [L,R=301]
    RewriteRule ^pump/residential-pumps/centrifugal-shallow-well-jet/?$ https://www.bombayengg.net/pump/residential-pumps/shallow-well-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/single-pump-booster/?$ https://www.bombayengg.net/pump/residential-pumps/booster-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/borewell-submersible/?$ https://www.bombayengg.net/pump/residential-pumps/4-inch-borewell/ [L,R=301]
    RewriteRule ^pump/residential-pumps/mini-pumps/50-30/?$ https://www.bombayengg.net/pump/residential-pumps/mini-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/mini-pumps/100-33/?$ https://www.bombayengg.net/pump/residential-pumps/mini-pumps/ [L,R=301]
    RewriteRule ^pump/residential-pumps/mini-pumps/150/?$ https://www.bombayengg.net/pump/residential-pumps/mini-pumps/ [L,R=301]
    RewriteRule ^pump/agricultural-pump/open-well/?$ https://www.bombayengg.net/pump/residential-pumps/openwell-pumps/ [L,R=301]
    RewriteRule ^pump/agricultural-pump/borewell/?$ https://www.bombayengg.net/pump/residential-pumps/4-inch-borewell/ [L,R=301]
    RewriteRule ^pump/agricultural-pump/centrifugial/?$ https://www.bombayengg.net/pump/agricultural-pump/centrifugal-monoset/ [L,R=301]
    # "agricultural-pumps" (plural) → same targets as singular
    RewriteRule ^pump/agricultural-pumps/open-well/?$ https://www.bombayengg.net/pump/residential-pumps/openwell-pumps/ [L,R=301]
    RewriteRule ^pump/agricultural-pumps/borewell/?$ https://www.bombayengg.net/pump/residential-pumps/4-inch-borewell/ [L,R=301]
    RewriteRule ^pump/agricultural-pumps/?$ https://www.bombayengg.net/pump/agricultural-pump/ [L,R=301]

    # Misc old pages
    RewriteRule ^electric/?$ https://www.bombayengg.net/motor/ [L,R=301]
    RewriteRule ^home-pump/?$ https://www.bombayengg.net/pump/ [L,R=301]

    # GSC-reported 404s — old URL fragments that need targeted redirects
    RewriteRule ^motor/dc-motor/solid-yoke-dc-motor/ac-motor1-third-leve/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/ [L,R=301]
    RewriteRule ^motor/dc-motor/solid-yoke-dc-motor/(.+)$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/dc-motors/ [L,R=301]
    RewriteRule ^motor/high-voltage-ac-motors/(.*)$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/high-voltage-motors/ [L,R=301]
    RewriteRule ^motor/low-voltage-ac-motor/slip-ring-induction-motors/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/slip-ring-motors-lv/ [L,R=301]
    RewriteRule ^motor/low-voltage-ac-motor/(.+)/(.+)/?$ https://www.bombayengg.net/motor/high-low-voltage-ac-dc-motors/low-voltage-motors/ [L,R=301]
    # ── END OLD URL REDIRECTS ────────────────────────────────────────────

    # eSSL/ZKTeco biometric device push (iclock/ADMS protocol) — route the
    # firmware-fixed /iclock/* paths to our handler; skip all redirects/routing.
    RewriteRule ^iclock/ core/essl-push.php [L,QSA]

    # Enforce trailing slash on all public URLs (prevents duplicate content)
    # Skip files with extensions, skip xadmin, skip API/callback endpoints
    RewriteCond %{REQUEST_URI} !^/xadmin [NC]
    RewriteCond %{REQUEST_URI} !^/core/ [NC]
    RewriteCond %{REQUEST_URI} !^/uploads/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !\.([a-zA-Z0-9]{2,5})$
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]

    # Skip rewrites for static paths and files (NOT in xsite)
    RewriteCond %{REQUEST_URI} ^/uploads/ [OR]
    RewriteCond %{REQUEST_URI} ^/core/ [OR]
    RewriteCond %{REQUEST_URI} ^/lib/ [OR]
    RewriteCond %{REQUEST_URI} ^/phpmyadmin/ [OR]
    RewriteCond %{REQUEST_URI} ^/config\.js\.php$ [OR]
    RewriteCond %{REQUEST_URI} ^/robots\.txt$ [OR]
    RewriteCond %{REQUEST_URI} ^/hrms-sw\.js$
    RewriteRule ^ - [L]

    # Direct serve sitemap files from xsite folder (for SEO)
    RewriteRule ^sitemap\.xml$ xsite/sitemap.xml [L]
    RewriteRule ^sitemap_index\.xml$ xsite/sitemap_index.xml [L]

    # Default rewrite to xsite folder
    RewriteCond %{REQUEST_URI} !^/xadmin [NC]
    RewriteCond %{REQUEST_URI} !^/phpmyadmin [NC]
    RewriteCond %{REQUEST_URI} !^/claude\.php$ [NC]

    # Block direct web access to vendor directory
    RewriteRule ^vendor/ - [F,L]

    RewriteRule ^(.*)$ xsite/$1 [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS — tells browsers to always use HTTPS, eliminates the 302 from server-level redirect on subsequent visits
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ==================== BROWSER CACHING ====================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML - no cache (dynamic content)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript - 1 year
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images - 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Fonts - 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/eot "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # PDF & Documents
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # Images, CSS, JS, Fonts - 1 year cache
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg|css|js|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # HTML - no cache
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # PDF - 1 month cache
    <FilesMatch "\.(pdf)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

# ==================== GZIP COMPRESSION ====================
<IfModule mod_deflate.c>
    # Compress text-based files
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf

    # Don't compress already compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz|bz2|rar|pdf)$ no-gzip
</IfModule>

# ==================== ETags ====================
# Remove ETags (use Cache-Control instead)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
